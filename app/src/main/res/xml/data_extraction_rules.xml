<?xml version="1.0" encoding="utf-8"?>
<!--
  Cloud backup is disabled via android:allowBackup="false". Device-to-device
  transfer can still apply these rules: exclude secrets and the sync index so a
  partial restore cannot trigger offline-deletion tombstones on peers.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="tailsync_secure.xml"/>
        <exclude domain="sharedpref" path="tailsync_settings.xml"/>
        <exclude domain="file" path="tailsync-state"/>
        <exclude domain="file" path="tailsync-diag.log"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="tailsync_secure.xml"/>
        <exclude domain="sharedpref" path="tailsync_settings.xml"/>
        <exclude domain="file" path="tailsync-state"/>
        <exclude domain="file" path="tailsync-diag.log"/>
    </device-transfer>
</data-extraction-rules>
