<?xml version="1.0" encoding="utf-8"?>
<!--
  allowBackup is false in the manifest. These excludes still document intent and
  defend against future allowBackup flips or toolchains that honor this file.
  Never back up encrypted prefs (auth key) or the sync index / tsnet state:
  a restored index against a different or empty sync tree can mass-delete peers.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="tailsync_secure.xml"/>
    <exclude domain="sharedpref" path="tailsync_settings.xml"/>
    <exclude domain="file" path="tailsync-state"/>
    <exclude domain="file" path="tailsync-diag.log"/>
</full-backup-content>
